# Copy this file to .env and fill in the values from your Spotify app.
#
# 1. Go to https://developer.spotify.com/dashboard and click "Create app"
# 2. Name it anything (e.g. "lyric search")
# 3. Set the Redirect URI to EXACTLY:
#       http://127.0.0.1:3000/callback
#    Spotify rejects http://localhost — it must be the loopback IP.
# 4. Check "Web API", save, then copy the two values below.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Only change this if you also change the Redirect URI in the dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# ── Optional ──
# Port the server listens on (default 3000). If you change it, update the
# Redirect URI above and in the Spotify dashboard to match.
# PORT=3000

# Where your Spotify export JSON and the generated spotify.db live.
# Defaults to apps/personal/Data/; only set these if you moved it.
# (In Docker these are set to /data by the image.)
# EXPORT_DIR=../Data
# DATA_DIR=../Data

# How many seconds a track must play before it counts as a LISTEN rather than a
# skip. Default 30, which is Spotify's own rule — it is what Wrapped counts and
# what triggers a royalty payment.
#
# Both numbers are always kept: "plays" counts every time a track started,
# "listens" counts only those past this threshold. Lower it if you think ten
# seconds is enough to say you heard a song.
#
# Changing it takes effect on the next `npm run ingest`, which recomputes the
# counts from your export. Song ids and already-fetched lyrics are preserved,
# so re-ingesting is cheap and safe.
# SKIP_THRESHOLD_SECONDS=30
