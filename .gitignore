# ─── dependencies ───
node_modules/

# ─── secrets ───
.env
**/.env
*.local

# ─── local editor / Claude Code config ───
.claude/
**/.claude/
.vscode/
.idea/

# ─── personal Spotify export + everything derived from it ───
# Keep the Data/ folder in the repo but never its contents. Each user drops
# their own export in here (see apps/personal/Data/README.md).
apps/personal/Data/*
!apps/personal/Data/.gitkeep
!apps/personal/Data/README.md

# ─── uploaded export blobs (hosted service, local dev) ───
apps/web/blobs/

# ─── production database dumps (written on the server by deploy/backup.sh) ───
deploy/backups/

# ─── sqlite database (built locally from your own data) ───
*.db
*.db-shm
*.db-wal

# ─── os cruft ───
.DS_Store
Thumbs.db
