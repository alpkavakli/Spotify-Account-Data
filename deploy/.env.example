# Copy to `deploy/.env` and fill in. That file is git-ignored and is the only
# place production secrets live on the box.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value here is read by docker-compose.yml. Full walkthrough:
# docs/08-DEPLOYMENT.md.


# ── the public address ──────────────────────────────────────────────────────

# The hostname Caddy serves and gets a certificate for. Its DNS A/AAAA record
# must already point at this box, or the certificate request fails.
# Use `:80` instead of a hostname to run the stack over plain HTTP with no DNS
# (local trial only — sign-in cookies are `secure`, so this is not a way to run
# the real thing).
DOMAIN=lyricsearch.example.com

# Where Let's Encrypt sends expiry warnings. A real inbox you read.
# Must not be left blank: Caddy will not parse an `email` directive with no
# argument, and the container restart-loops.
ACME_EMAIL=you@example.com

# The origin sign-in links are built from. Must be the address a browser uses —
# this is what goes in the email, and a wrong value produces links that reach
# nobody. Must be https:// (the API refuses to start otherwise, because the
# session cookie is `secure` and a plaintext origin drops it silently).
BASE_URL=https://lyricsearch.example.com


# ── database ────────────────────────────────────────────────────────────────

# Generate, do not invent:  openssl rand -base64 32
# Postgres is not published outside the compose network, but this is also what
# the daily backup dumps with. Changing it later means changing it in the
# running container too, not just here.
POSTGRES_PASSWORD=


# ── email ───────────────────────────────────────────────────────────────────
#
# Passwordless sign-in is the ONLY mail the service sends, and it is the whole
# login system: if it does not arrive, nobody can get in. The API refuses to
# start in production until this is set.
#
# Any SMTP provider works — Resend, Postmark, SES, Fastmail, Mailgun. Use a
# transactional provider rather than a personal mailbox: sign-in mail has to
# survive spam filters, which needs SPF and DKIM on the sending domain.

# The From: address. Its domain must be one the provider has verified.
MAIL_FROM=Lyric Search <signin@lyricsearch.example.com>

# Either one URL…
# (percent-encode the password if it contains @ : / or ?)
SMTP_URL=smtp://apikey:secret@smtp.example.com:587

# …or discrete values. Use these when the password contains characters that do
# not survive a URL — AWS SES passwords are base64 and routinely do not.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=      # true for implicit TLS; inferred from port 465 if unset


# ── tuning (optional) ───────────────────────────────────────────────────────

# Songs per lyric-fetch pass. The worker re-queues itself until the backlog is
# empty, so this is the size of one polite batch against LRCLIB, not a cap.
# LYRIC_BATCH=200
